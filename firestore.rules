rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY-SPECIFIC VALIDATION HELPERS ---
    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 50
        && data.address is string && data.address.size() <= 200
        && data.templateId is string && data.templateId.size() <= 50
        && data.customSizes is map
        && data.userId is string && data.userId == request.auth.uid;
    }

    function isValidWorker(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.role is string && data.role.size() <= 100
        && data.unpaidWages is number
        && data.completedCount is number
        && data.userId is string && data.userId == request.auth.uid;
    }

    function isValidOrder(data) {
      return data.workerName is string && data.workerName.size() > 0 && data.workerName.size() <= 100
        && data.task is string && data.task.size() > 0 && data.task.size() <= 200
        && data.wage is number
        && data.time is string && data.time.size() <= 50
        && data.userId is string && data.userId == request.auth.uid;
    }

    function isValidInventory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.unitType is string && data.unitType.size() <= 50
        && data.cost is number
        && data.price is number
        && data.stock is number
        && data.userId is string && data.userId == request.auth.uid;
    }

    // --- COLLECTION RULES ---

    // 1. Customers Collection
    match /customers/{customerId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isSignedIn() && isValidCustomer(incoming()) && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 2. Workers Collection
    match /workers/{workerId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(workerId) && isValidWorker(incoming());
      allow update: if isSignedIn() && isValidWorker(incoming()) && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isSignedIn() && isValidOrder(incoming()) && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 4. Inventory Collection
    match /inventory/{inventoryId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(inventoryId) && isValidInventory(incoming());
      allow update: if isSignedIn() && isValidInventory(incoming()) && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 5. Global Sub-Users Authentication Registrar
    match /global_sub_users/{subUserId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    // 6. Primary Owner Profiles & Contact Lookup Scanner
    match /users/{ownerId} {
      allow read, write: if isSignedIn() && request.auth.uid == ownerId;
      allow list: if isSignedIn();
      
      match /{allPaths=**} {
        allow read, write: if isSignedIn() && request.auth.uid == ownerId;
      }

      match /notifications/{notifId} {
        allow read, write: if isSignedIn() && request.auth.uid == ownerId;
        allow create: if isSignedIn();
      }
    }

    // 7. Global Owners Public Registry for Contact Matching 
    match /global_owners_directory/{ownerId} {
      allow write: if isSignedIn() && (ownerId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow read, list: if isSignedIn();
    }

    // 8. Secure Real-Time Chat Engine (Peer-to-Peer Messaging)
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (chatId.matches('^' + request.auth.uid + '_.*') || chatId.matches('.*_' + request.auth.uid + '$'));
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (chatId.matches('^' + request.auth.uid + '_.*') || chatId.matches('.*_' + request.auth.uid + '$'));
      }
    }
  }
}
