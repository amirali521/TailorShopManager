rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core check: user must be authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Tenant check: ensuring resource belongs to the logged-in shop
    function belongsToTenant(userId) {
      return request.auth.uid == userId;
    }

    // Validate resource changes during updates/creates
    function isTenantOwner(resourceData) {
      return request.auth.uid == resourceData.userId;
    }

    match /shops/{shopId} {
      allow read, write: if isAuthenticated() && belongsToTenant(shopId);
    }

    match /{collectionName}/{docId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || isTenantOwner(resource.data)) && 
        (request.resource == null || isTenantOwner(request.resource.data));
    }
  }
}
